# Byte-compiled / optimized / Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/
.env

# Output & processed media
output/
outputs/
*.log

# Streamlit local state
.streamlit/

# IDE & OS system files
.vscode/
.idea/
.worktrees/
*.swp
*.swo
.DS_Store
Thumbs.db

# Enrolled-face gallery (runtime user data, not source)
/gallery/

# Saved-face database + images (runtime user data, not source)
/db/
/faces/
/eigen/
/known_people/

# Model weights are downloaded by tools/fetch_models.py (see models/manifest.json), never
# committed. Only the manifest and the small files that stay in git are tracked; keep these
# exceptions in sync with the "in_git" entries of the manifest and with .dockerignore.
/models/*
!/models/manifest.json
!/models/opencv_face_detector.pbtxt
!/models/opencv_face_detector_uint8.pb
!/models/haarcascade_eye.xml
!/models/colorization_deploy_v2.prototxt
!/models/pts_in_hull.npy
!/models/mivolo_v2_config.json
!/models/BFM/
/models/BFM/*
!/models/BFM/similarity_Lm3D_all.mat

# Packaging artifacts (pip install . / pip install -e .)
*.egg-info/
/build/

# Held-out evaluation: separate venv and downloaded dataset/cache (see docs/eval/)
/.venv-eval/
/data/
